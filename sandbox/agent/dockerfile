FROM node:20-bullseye

WORKDIR /app

# Native Node.js modules build karne ke tools
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*
    

COPY package*.json ./ 

RUN  npm install

COPY . . 

EXPOSE 3000

RUN mkdir /workspace

CMD [ "npm","run","dev"]